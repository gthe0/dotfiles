;;; README.el --- Notes for ~/.emacs.d/user-lisp/ -*- lexical-binding: t; -*-

;; Put personal/local Emacs Lisp libraries in this directory.
;;
;; Emacs 31 provides user-lisp-directory and its associated preparation/
;; compilation support.  Keep this directory for your own Lisp rather than
;; cloning third-party package repositories into it.
;;
;; After adding or changing libraries, use:
;;
;;     M-x prepare-user-lisp
;;
;; when you want Emacs to prepare/byte-compile the directory.
;;
;;; README.el ends here
